// Esquema de base de datos - Recetas de Conciliación
// Motor: PostgreSQL (probado con Supabase). `url` debe ser la cadena de
// conexión "pooled" (pgbouncer, puerto 6543) para funciones serverless;
// `directUrl` es la conexión directa (puerto 5432), usada solo por
// `prisma migrate` para aplicar el esquema. Ver README.md para el detalle
// de dónde obtener cada una en Supabase.

generator client {
  provider      = "prisma-client-js"
  // "native" para desarrollo local; "rhel-openssl-3.0.x" es el binario que
  // necesita el runtime de funciones serverless de Vercel (Amazon Linux).
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  PLANEAMIENTO
  DOC_TECNICA
  ADMIN
}

enum TipoFlujo {
  GENERAR_RECETA
  ACTUALIZAR_SIN_CONCILIACION
}

enum EstadoRegistro {
  PENDIENTE_PLANEAMIENTO // Creado por Planeamiento, datos base en edición
  EN_REVISION_TECNICA // Planeamiento definió la ruta y notificó a Doc. Técnica
  ENTREGADA // Doc. Técnica completó su parte (la ruta elegida vive en tipoFlujo), pendiente de que Planeamiento la concluya
  RECHAZADA_TECNICA // Doc. Técnica indicó que no pudo generar la receta, con motivo
  CONCLUIDA // Planeamiento dio por buena la receta/actualización: cierre final

  // RECETA_GENERADA y ACTUALIZACION_COMPLETADA quedan reservados (ya no se
  // usan desde la app: se fusionaron en ENTREGADA, que junto a tipoFlujo
  // representa lo mismo con un estado menos). Postgres no permite borrar
  // valores de un enum ya creado sin recrear el tipo; se dejan sin uso en
  // vez de arriesgar esa migración contra datos reales.
  RECETA_GENERADA
  ACTUALIZACION_COMPLETADA
}

enum TriggerCorreo {
  NUEVO_REQUERIMIENTO // Trigger 1: Planeamiento guarda datos base y elige ruta
  RECETA_LISTA // Trigger 2: Documentación Técnica completa su tarea
  RECHAZO_TECNICO // Documentación Técnica no pudo generar la receta
  DECISION_PLANEAMIENTO // Planeamiento concluye o rechaza el trabajo de Documentación Técnica
}

enum EstadoEnvioCorreo {
  PENDIENTE
  ENVIADO
  FALLIDO
}

model User {
  id        String   @id @default(cuid())
  nombre    String
  email     String   @unique
  role      Role
  puesto    String?
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  registrosCreados      ConciliationRecord[] @relation("CreadoPor")
  respuestasCompletadas TechnicalResponse[]  @relation("CompletadoPor")
  historial             StatusHistory[]      @relation("CambiadoPor")
}

// Entidad principal: un requerimiento de conciliación / actualización de receta.
// Corresponde a una fila del Excel histórico (Cod. Pro., Producto, Planta,
// Fecha de Conciliación, Motivo de Conciliación) + el flujo de estados nuevo.
model ConciliationRecord {
  id                   String   @id @default(cuid())
  codigoProducto       String? // "Cod. Pro." - opcional: el histórico trae vacíos y "-"
  producto             String
  planta               String // "1" o "2"
  fechaConciliacion    DateTime
  motivoConciliacion   String
  materialesAConciliar String
  asuntosRegulatorios  String?

  tipoFlujo TipoFlujo? // se define recién cuando Planeamiento toma la decisión
  estado    EstadoRegistro @default(PENDIENTE_PLANEAMIENTO)

  creadoPorId String
  creadoPor   User   @relation("CreadoPor", fields: [creadoPorId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  lotes            RecordLote[]
  respuestaTecnica TechnicalResponse?
  destinatarios    EmailRecipient[]
  correos          EmailLog[]
  historial        StatusHistory[]
  listasConciliar  RecordListaConciliar[]

  @@index([estado])
  @@index([planta])
  @@index([codigoProducto])
}

// Lotes asociados al requerimiento (el Excel original lista múltiples lotes
// y materiales en texto libre; aquí se normalizan como filas independientes).
model RecordLote {
  id         String             @id @default(cuid())
  recordId   String
  record     ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  numeroLote String
  detalle    String?

  @@index([recordId])
}

// Listas de materiales (BOM) que se van a conciliar en este requerimiento.
// Cada fila viene de una de dos fuentes ("origen"): "SAP" (elegida buscando
// en el Maestro de Listas de Materiales de la herramienta SAP MM & LM — se
// guardan sus datos ya resueltos, no una referencia en vivo) o "MANUAL"
// (escrita a mano cuando la lista no está en SAP o no se encontró).
model RecordListaConciliar {
  id       String             @id @default(cuid())
  recordId String
  record   ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)

  origen String // "SAP" | "MANUAL"

  // Presentes cuando origen = "SAP" (copiados del Maestro de Listas de
  // Materiales al momento de elegir, para no depender de una consulta en
  // vivo a otro proyecto de Supabase cada vez que se muestra el registro).
  material String?
  listaAlt String?
  producto String?
  centro   String?
  estado   String?

  // Texto libre: obligatorio cuando origen = "MANUAL", opcional como nota
  // adicional cuando origen = "SAP".
  descripcion String?

  createdAt DateTime @default(now())

  @@index([recordId])
}

// Campos exclusivos de Documentación Técnica (uno a uno con el registro).
model TechnicalResponse {
  id            String             @id @default(cuid())
  recordId      String             @unique
  record        ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  variantes     String?
  ejecucion     String?
  observaciones String?
  motivoRechazo String? // Por qué Documentación Técnica no pudo generar la receta (estado RECHAZADA_TECNICA)

  completadoPorId String?
  completadoPor   User?     @relation("CompletadoPor", fields: [completadoPorId], references: [id])
  completadoAt    DateTime?

  updatedAt DateTime @updatedAt
}

// Correos ingresados en el campo tipo "etiquetas" del frontend, por cada
// disparador. Queda como registro de a quién se notificó y cuándo.
model EmailRecipient {
  id        String             @id @default(cuid())
  recordId  String
  record    ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  email     String
  trigger   TriggerCorreo
  createdAt DateTime           @default(now())

  @@index([recordId, trigger])
}

// Outbox de correos: cada cambio de estado que dispara notificación crea una
// fila aquí. En producción (Vercel) se intenta enviar en línea dentro de la
// misma request; si falla, un Cron Job la reintenta llamando al endpoint
// /api/cron/process-emails (ver services/email.worker.ts).
model EmailLog {
  id            String             @id @default(cuid())
  recordId      String
  record        ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  trigger       TriggerCorreo
  destinatarios String // JSON.stringify(string[])
  asunto        String
  cuerpoHtml    String
  estado        EstadoEnvioCorreo  @default(PENDIENTE)
  intentos      Int                @default(0)
  ultimoError   String?
  createdAt     DateTime           @default(now())
  enviadoAt     DateTime?

  @@index([estado])
}

// Auditoría de cambios de estado (quién, cuándo, de qué a qué).
model StatusHistory {
  id            String             @id @default(cuid())
  recordId      String
  record        ConciliationRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  estadoDesde   EstadoRegistro?
  estadoHasta   EstadoRegistro
  comentario    String?
  cambiadoPorId String
  cambiadoPor   User               @relation("CambiadoPor", fields: [cambiadoPorId], references: [id])
  createdAt     DateTime           @default(now())

  @@index([recordId])
}
