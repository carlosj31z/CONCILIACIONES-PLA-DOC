# Base de datos (SQLite para desarrollo local; usar postgresql://... en producción)
DATABASE_URL="file:./dev.db"

# Servidor
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Autenticación
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# --- Correo saliente ---
# La app despacha los correos por su cuenta (no depende de que el usuario
# tenga Outlook abierto). Recomendado: SMTP AUTH de Microsoft 365/Outlook
# con una cuenta de servicio (buzón compartido) o un App Password.
# Alternativa: cualquier proveedor SMTP (SendGrid, Amazon SES, etc.) usando
# las mismas variables.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="conciliaciones@tuempresa.com"
SMTP_PASSWORD="app-password-o-clave-de-la-cuenta-de-servicio"
MAIL_FROM="Recetas de Conciliación <conciliaciones@tuempresa.com>"

# URL pública del frontend, usada para armar el link "Ver registro" en los correos
APP_BASE_URL="http://localhost:5173"

# Cada cuántos ms el worker revisa la cola de correos pendientes
EMAIL_WORKER_INTERVAL_MS=5000
