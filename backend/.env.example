# --- Base de datos (Supabase Postgres) ---
# DATABASE_URL: cadena "Connection pooling" (Transaction mode, pgbouncer,
#   puerto 6543). Es la que usa la app en cada request.
# DIRECT_URL: cadena "Direct connection" (puerto 5432). Solo la usa
#   `prisma migrate` para aplicar el esquema (pgbouncer no soporta las
#   sentencias que usa migrate).
# Ambas se obtienen en Supabase: Project Settings -> Database -> Connection string.
DATABASE_URL="postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgresql://postgres.xxxxx:TU_PASSWORD@aws-0-xx-xxxx-1.pooler.supabase.com:5432/postgres"

# Servidor (solo desarrollo local; en Vercel no se usa PORT)
PORT=4000
CORS_ORIGIN="http://localhost:5173"

# Autenticación
JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

# --- Correo saliente ---
# La app despacha los correos por su cuenta (no depende de que el usuario
# tenga Outlook abierto). Recomendado: SMTP AUTH de Microsoft 365/Outlook
# con una cuenta de servicio (buzón compartido) o un App Password.
# Alternativa: cualquier proveedor SMTP (SendGrid, Amazon SES, etc.) usando
# las mismas variables.
SMTP_HOST="smtp.office365.com"
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER="conciliaciones@tuempresa.com"
SMTP_PASSWORD="app-password-o-clave-de-la-cuenta-de-servicio"
MAIL_FROM="Recetas de Conciliación <conciliaciones@tuempresa.com>"

# URL pública de la app, usada para armar el link "Ver registro" en los correos
# (en Vercel: https://tu-proyecto.vercel.app)
APP_BASE_URL="http://localhost:5173"

# Solo desarrollo local (`npm run dev`): cada cuántos ms el worker en proceso
# revisa la cola de correos pendientes. En Vercel el envío es en línea y el
# reintento lo hace el Cron Job de /api/cron/process-emails (ver README).
EMAIL_WORKER_INTERVAL_MS=5000

# Secreto que debe enviar el Cron Job de Vercel (header Authorization: Bearer
# <valor>) para poder llamar a /api/cron/process-emails. Genera un valor
# aleatorio largo; Vercel lo agrega automáticamente al header en cada
# invocación de cron si está configurado como variable de entorno CRON_SECRET.
CRON_SECRET="otro-secreto-largo-y-aleatorio"

# --- Archivos adjuntos de las notas (Supabase Storage) ---
# Las notas de un requerimiento aceptan imágenes y documentos. El archivo va a
# un bucket PRIVADO de Supabase Storage y en la base solo queda su ruta.
# SUPABASE_URL: "Project URL" del proyecto (Project Settings -> API).
# SUPABASE_SERVICE_ROLE_KEY: la clave `service_role`, NO la `anon`. Salta las
#   políticas de RLS, así que solo puede vivir en el backend: quién puede abrir
#   cada archivo lo decide el controlador de notas según quién la escribió, y
#   al navegador solo le llega un enlace firmado que vence en una hora.
# Sin estas dos variables la app funciona igual, pero adjuntar un archivo a una
# nota responde 503 explicando que falta configurar el almacenamiento.
SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="clave-service-role-del-proyecto"
SUPABASE_STORAGE_BUCKET="notas-adjuntos"
